# Normalise line endings so the three of us on different machines do not
# generate whitespace-only diffs. Text is LF in the repo, native on checkout.
* text=auto

*.py     text eol=lf
*.js     text eol=lf
*.html   text eol=lf
*.css    text eol=lf
*.json   text eol=lf
*.md     text eol=lf
*.yml    text eol=lf
*.ini    text eol=lf
*.cpp    text eol=lf
*.h      text eol=lf
*.csv    text eol=lf

*.png    binary
*.tflite binary
*.pkl    binary
*.keras  binary

# Vendored web fonts
*.woff2  binary
*.woff   binary
